# Leave LLM_PROVIDER unset to use Groq when GROQ_API_KEY is set, then Gemini.
# Set LLM_PROVIDER=mock to force the offline desk even if a key is present.
# With no keys, the desk always runs offline. CI does not need secrets.
# LLM_PROVIDER=mock

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

WHATSAPP_VERIFY_TOKEN=summit-ridge-verify
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
MESSENGER_VERIFY_TOKEN=summit-ridge-verify
MESSENGER_PAGE_TOKEN=

# Optional. Local default is data/store.json. On Vercel this is ignored in favor of /tmp unless you set it to a writable path.
DATA_PATH=
SUBDOMAIN=realty-chat
PUBLIC_BASE_URL=https://realty-chat.quvantic.com
